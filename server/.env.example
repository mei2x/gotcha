DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
PORT=4000
JWT_SECRET="generate a long random string, e.g. `openssl rand -hex 32`"

# The deployed web app's URL, for CORS. In production this must be the
# exact origin (no trailing slash), e.g. https://gotcha.vercel.app
WEB_ORIGIN="http://localhost:3000"

# Set to "production" when deployed — controls cookie sameSite/secure flags.
NODE_ENV="development"

# Optional: which account auto-login POSTs to /api/auth/demo-login use.
# DEMO_USERNAME="demo"

# Required to call POST /api/auth/demo-snapshot (captures the demo account's
# current state as the baseline /demo-login resets back to on every visit).
# Keep this out of the browser — only use it from curl/a terminal:
#   curl -X POST <api>/api/auth/demo-snapshot -H "x-demo-secret: <this value>"
DEMO_SNAPSHOT_SECRET="generate a long random string, e.g. `openssl rand -hex 32`"
